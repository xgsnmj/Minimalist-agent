          <mxGeometry x="60" y="24" width="620" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="subtitle" value="主线：用户发起 Agent 对话 -> 后端创建 Run -> Worker 执行 Agent Runtime -> 能力调用与事件落库 -> SSE 返回前端" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=14;fontColor=#4B5563;" vertex="1" parent="1">
