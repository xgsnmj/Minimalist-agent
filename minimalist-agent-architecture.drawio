  <diagram id="minimalist-agent-architecture" name="Minimalist Agent 简化分层架构">
    <mxGraphModel adaptiveColors="auto" dx="1600" dy="1200" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1320" math="0" shadow="0">
